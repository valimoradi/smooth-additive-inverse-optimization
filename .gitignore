refactored/data_files/

# Workspace archive (~660 MB of old experiments, scripts, logs).
# Kept locally for reference; not under version control.
archive/

# Downloaded copyrighted reference PDFs for literature review.
# Kept locally; not under version control.
literature_review/

# Pickled / numpy artifacts at any depth
*.npy
*.pkl

